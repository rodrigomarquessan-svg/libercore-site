---
import Layout from "../../layouts/Layout.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import { servicos } from "../../data/servicos";
---

<Layout title="Serviços — LiberCore Contabilidade">
  <section class="bg-ink text-cream py-24 lg:py-32">
    <div class="max-w-5xl mx-auto px-6 lg:px-10">
      <span class="eyebrow">O que fazemos</span>
      <h1 class="mt-8 text-5xl md:text-6xl lg:text-7xl font-display max-w-3xl leading-[1.05]">
        Serviços <em class="italic text-gold">completos</em>, atendimento dedicado.
      </h1>
      <p class="mt-8 max-w-2xl text-lg md:text-xl text-cream/70 leading-relaxed">
        Centralizamos contabilidade, fiscal, tributário, departamento pessoal e patrimônio — no Brasil e no exterior. Sem fragmentação, sem retrabalho.
      </p>
    </div>
  </section>

  <section class="py-24 lg:py-32 max-w-7xl mx-auto px-6 lg:px-10">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {servicos.map((s, i) => (
        <ServiceCard
          title={s.titulo}
          description={s.resumo}
          href={`/servicos/${s.slug}`}
          icon={s.icon}
          index={i}
        />
      ))}
    </div>
  </section>
</Layout>
