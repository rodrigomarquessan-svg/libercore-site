---
import Layout from "../../layouts/Layout.astro";
import { servicos } from "../../data/servicos";

export function getStaticPaths() {
  return servicos.map(s => ({ params: { slug: s.slug }, props: { servico: s } }));
}

const { servico } = Astro.props;
const outros = servicos.filter(s => s.slug !== servico.slug).slice(0, 3);
---

<Layout title={`${servico.titulo} — LiberCore Contabilidade`} description={servico.resumo}>
  <section class="bg-ink text-cream py-24 lg:py-32">
    <div class="max-w-5xl mx-auto px-6 lg:px-10">
      <a href="/servicos" class="inline-flex items-center gap-2 text-sm text-cream/60 hover:text-gold transition-colors mb-8">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Todos os serviços
      </a>
      <span class="eyebrow">Serviço</span>
      <h1 class="mt-6 text-5xl md:text-6xl lg:text-7xl font-display max-w-3xl leading-[1.05]">
        {servico.titulo}
      </h1>
      <p class="mt-8 max-w-2xl text-lg md:text-xl text-cream/70 leading-relaxed">
        {servico.descricaoCurta}
      </p>
    </div>
  </section>

  <section class="py-24 lg:py-32 max-w-5xl mx-auto px-6 lg:px-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-7">
        <span class="eyebrow">O que entregamos</span>
        <h2 class="mt-6 text-3xl md:text-4xl font-display">Escopo do atendimento</h2>
        <ul class="mt-10 space-y-4">
          {servico.itens.map(item => (
            <li class="flex items-start gap-4 pb-4 border-b border-ink/10">
              <div class="mt-1.5 w-1.5 h-1.5 rounded-full bg-gold flex-shrink-0"></div>
              <span class="text-ink/85">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <aside class="lg:col-span-5">
        <div class="sticky top-28 bg-cream-soft p-8 rounded-2xl">
          <span class="eyebrow">Para quem é</span>
          <p class="mt-6 text-base text-ink/80 leading-relaxed">{servico.paraQuem}</p>

          <a href="/contato" class="mt-8 inline-flex items-center gap-2 px-6 py-3 text-sm font-medium text-cream bg-ink hover:bg-navy-deep transition-colors rounded-full">
            Falar sobre {servico.titulo.toLowerCase()}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="py-24 lg:py-32 bg-cream-soft/40">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <h2 class="text-3xl md:text-4xl font-display mb-12">Outros serviços</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {outros.map(s => (
          <a href={`/servicos/${s.slug}`} class="group block p-8 bg-cream rounded-2xl hover:bg-ink hover:text-cream transition-colors">
            <h3 class="text-xl font-display">{s.titulo}</h3>
            <p class="mt-3 text-sm text-ink/70 group-hover:text-cream/70 transition-colors">{s.resumo}</p>
            <div class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-gold">
              Ver
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
