---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contato — LiberCore Contabilidade">
  <section class="bg-ink text-cream py-24 lg:py-32">
    <div class="max-w-5xl mx-auto px-6 lg:px-10">
      <span class="eyebrow">Fale conosco</span>
      <h1 class="mt-8 text-5xl md:text-6xl lg:text-7xl font-display max-w-3xl leading-[1.05]">
        Vamos <em class="italic text-gold">conversar</em>.
      </h1>
      <p class="mt-8 max-w-2xl text-lg md:text-xl text-cream/70 leading-relaxed">
        Atendimento direto com um dos sócios. Conte seu cenário — entendemos seu contexto antes de propor solução.
      </p>
    </div>
  </section>

  <section class="py-24 lg:py-32 max-w-7xl mx-auto px-6 lg:px-10">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24">
      <!-- Formulário -->
      <div>
        <h2 class="text-3xl font-display">Envie uma mensagem</h2>
        <p class="mt-3 text-ink/70">Responderemos em até 1 dia útil.</p>

        <form
          action="https://formspree.io/f/mqejller"
          method="POST"
          class="mt-10 space-y-6"
        >
          <div>
            <label for="nome" class="block text-sm font-medium text-ink mb-2">Nome completo</label>
            <input type="text" id="nome" name="nome" required class="w-full px-5 py-3.5 bg-cream border border-ink/15 rounded-xl focus:outline-none focus:border-gold transition-colors" />
          </div>
          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <label for="email" class="block text-sm font-medium text-ink mb-2">Email</label>
              <input type="email" id="email" name="email" required class="w-full px-5 py-3.5 bg-cream border border-ink/15 rounded-xl focus:outline-none focus:border-gold transition-colors" />
            </div>
            <div>
              <label for="telefone" class="block text-sm font-medium text-ink mb-2">Telefone</label>
              <input type="tel" id="telefone" name="telefone" class="w-full px-5 py-3.5 bg-cream border border-ink/15 rounded-xl focus:outline-none focus:border-gold transition-colors" />
            </div>
          </div>
          <div>
            <label for="assunto" class="block text-sm font-medium text-ink mb-2">Assunto</label>
            <select id="assunto" name="assunto" class="w-full px-5 py-3.5 bg-cream border border-ink/15 rounded-xl focus:outline-none focus:border-gold transition-colors">
              <option>Pessoa Física / IRPF</option>
              <option>Offshore & Exterior</option>
              <option>Contabilidade empresarial</option>
              <option>Fiscal & Tributário</option>
              <option>Departamento Pessoal</option>
              <option>Holding Patrimonial</option>
              <option>Outro</option>
            </select>
          </div>
          <div>
            <label for="mensagem" class="block text-sm font-medium text-ink mb-2">Mensagem</label>
            <textarea id="mensagem" name="mensagem" rows="5" required class="w-full px-5 py-3.5 bg-cream border border-ink/15 rounded-xl focus:outline-none focus:border-gold transition-colors resize-none"></textarea>
          </div>
          <button type="submit" class="inline-flex items-center gap-2 px-8 py-4 text-base font-medium text-cream bg-ink hover:bg-navy-deep transition-colors rounded-full">
            Enviar mensagem
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </button>

          <p class="text-xs text-ink/50 leading-relaxed">
            Ao enviar, seus dados serão tratados para atender à sua solicitação, conforme o
            <a href="/privacidade" class="underline underline-offset-2 hover:text-gold transition-colors">Aviso de Privacidade</a>.
          </p>
        </form>
      </div>

      <!-- Informações -->
      <div class="space-y-12">
        <div>
          <h2 class="text-3xl font-display">Outros canais</h2>

          <div class="mt-8 space-y-6">
            <a href="mailto:contato@contalibercore.com" class="flex items-start gap-4 p-5 bg-cream-soft hover:bg-ink hover:text-cream transition-colors rounded-xl group">
              <div class="w-10 h-10 rounded-lg bg-gold/20 group-hover:bg-gold flex items-center justify-center text-gold group-hover:text-ink transition-colors">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
              </div>
              <div>
                <div class="text-xs uppercase tracking-wider text-ink/50 group-hover:text-cream/50">Email</div>
                <div class="mt-1 font-medium">contato@contalibercore.com</div>
              </div>
            </a>

            <a href="tel:+5511969156746" class="flex items-start gap-4 p-5 bg-cream-soft hover:bg-ink hover:text-cream transition-colors rounded-xl group">
              <div class="w-10 h-10 rounded-lg bg-gold/20 group-hover:bg-gold flex items-center justify-center text-gold group-hover:text-ink transition-colors">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <div class="text-xs uppercase tracking-wider text-ink/50 group-hover:text-cream/50">Telefone</div>
                <div class="mt-1 font-medium">(11) 96915-6746</div>
              </div>
            </a>

            <a href="https://wa.me/5511969156746" target="_blank" rel="noopener" class="flex items-start gap-4 p-5 bg-cream-soft hover:bg-ink hover:text-cream transition-colors rounded-xl group">
              <div class="w-10 h-10 rounded-lg bg-gold/20 group-hover:bg-gold flex items-center justify-center text-gold group-hover:text-ink transition-colors">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.6-.8-1.9-.9-.3-.1-.4-.1-.6.1-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.3-1.4-.9-.7-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.6-1.5-.9-2-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-1 .9-1 2.3 0 1.3 1 2.7 1.1 2.9.1.2 2 3 4.8 4.2 1.7.7 2.3.7 3.1.6.5-.1 1.6-.6 1.8-1.3.2-.6.2-1.2.2-1.3-.1-.1-.3-.2-.6-.3z"/><path d="M19.4 4.6A10 10 0 0 0 12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.5 1.3 5L2 22l5.2-1.4c1.4.8 3.1 1.2 4.8 1.2 5.5 0 10-4.5 10-10 0-2.7-1-5.2-2.9-7.2zM12 20.4c-1.5 0-3-.4-4.3-1.2l-.3-.2-3.1.8.8-3-.2-.3c-.9-1.4-1.4-3-1.4-4.6 0-4.6 3.7-8.3 8.3-8.3 2.2 0 4.3.9 5.9 2.5 1.6 1.6 2.4 3.7 2.4 5.9.1 4.5-3.6 8.4-8.1 8.4z"/></svg>
              </div>
              <div>
                <div class="text-xs uppercase tracking-wider text-ink/50 group-hover:text-cream/50">WhatsApp</div>
                <div class="mt-1 font-medium">Enviar mensagem</div>
              </div>
            </a>
          </div>
        </div>

        <div>
          <h2 class="text-3xl font-display">Endereços</h2>
          <div class="mt-8 space-y-6">
            <div class="p-6 bg-cream-soft rounded-xl">
              <div class="text-xs uppercase tracking-wider text-gold">Atendimento Comercial</div>
              <p class="mt-2 font-medium">Av. Brig. Faria Lima, 1485</p>
              <p class="text-sm text-ink/70">Torre Norte, 2º andar — Itaim Bibi<br/>São Paulo — SP, 01452-002</p>
            </div>
            <div class="p-6 bg-cream-soft rounded-xl">
              <div class="text-xs uppercase tracking-wider text-gold">Sede</div>
              <p class="mt-2 font-medium">Rua Vilela, 976</p>
              <p class="text-sm text-ink/70">Tatuapé<br/>São Paulo — SP, 03314-000</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
