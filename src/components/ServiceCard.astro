---
interface Props {
  title: string;
  href: string;
  description: string;
  icon: string;
  index?: number;
}
const { title, href, description, icon, index = 0 } = Astro.props;
---

<a
  href={href}
  class="group relative block p-8 lg:p-10 bg-cream-soft hover:bg-ink hover:text-cream transition-all duration-500 rounded-2xl overflow-hidden"
>
  <div class="absolute top-0 right-0 w-32 h-32 bg-gold/5 rounded-full -translate-y-1/2 translate-x-1/2 group-hover:bg-gold/20 transition-colors"></div>

  <div class="relative">
    <div class="w-12 h-12 rounded-xl bg-ink text-cream group-hover:bg-gold group-hover:text-ink flex items-center justify-center transition-colors" set:html={icon}></div>

    <h3 class="mt-6 text-2xl lg:text-3xl font-display font-medium">
      {title}
    </h3>

    <p class="mt-4 text-sm leading-relaxed text-ink/70 group-hover:text-cream/70 transition-colors">
      {description}
    </p>

    <div class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-gold">
      Saiba mais
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
    </div>
  </div>
</a>
