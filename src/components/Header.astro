---
const navItems = [
  { label: "Serviços", href: "/servicos" },
  { label: "Sobre", href: "/sobre" },
  { label: "Contato", href: "/contato" },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-cream/80 border-b border-ink/5">
  <nav class="max-w-7xl mx-auto px-6 lg:px-10 h-28 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group">
      <img src="/images/logo-trimmed.png" alt="LiberCore" class="h-14 w-auto" />
      <span class="sr-only">LiberCore Contabilidade</span>
    </a>

    <ul class="hidden md:flex items-center gap-10">
      {navItems.map(item => (
        <li>
          <a
            href={item.href}
            class:list={[
              "text-base font-medium tracking-wide transition-colors",
              currentPath.startsWith(item.href) ? "text-ink" : "text-ink/60 hover:text-ink",
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href="/contato"
      class="hidden md:inline-flex items-center gap-2 px-6 py-3 text-base font-medium text-cream bg-ink hover:bg-navy-deep transition-colors rounded-full"
    >
      Fale conosco
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
    </a>

    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-ink"
      aria-label="Abrir menu"
      onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden border-t border-ink/5 bg-cream">
    <ul class="px-6 py-4 space-y-3">
      {navItems.map(item => (
        <li>
          <a href={item.href} class="block py-2 text-base text-ink">{item.label}</a>
        </li>
      ))}
      <li>
        <a href="/contato" class="block py-2 text-base font-medium text-gold">Fale conosco →</a>
      </li>
    </ul>
  </div>
</header>
